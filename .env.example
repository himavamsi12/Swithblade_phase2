# Copy to .env.local and fill in. Validated at startup by src/lib/env.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payload CMS database (server only). Postgres; Supabase recommended.
# Runtime: Supabase "Transaction pooler" string (port 6543).
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations (`pnpm migrate`): Supabase "Session pooler" string (port 5432).
DATABASE_MIGRATION_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Supabase root CA from Database settings -> SSL, as one line with \n escapes.
# Required in production so the TLS certificate is verified.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Connections per app instance. Defaults to 3 on Vercel, 10 elsewhere.
# DATABASE_POOL_MAX=10
PAYLOAD_SECRET=replace-with-output-of-openssl-rand-hex-32

# Supabase shopper auth (server only). From Supabase -> Connect -> Server.
# The publishable key is limited by RLS. The NEXT_PUBLIC_SUPABASE_URL /
# NEXT_PUBLIC_SUPABASE_ANON_KEY names work too. Public key only, never the secret key.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Media storage: Supabase Storage via its S3 endpoint. Without these, admin
# uploads go to local disk, which Vercel wipes. Create a private bucket, then
# Storage -> S3 Connection: endpoint, region, and an access key pair.
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Stripe (optional). Payments are enabled only when both keys are set.
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_...

# Razorpay (Magic) Checkout. Checkout is disabled while the keys are unset.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# Dashboard -> Webhooks (events: payment.authorized, payment.captured, order.paid) at
# <site>/api/razorpay/webhook. Enables the webhook backup for paid orders.
# RAZORPAY_WEBHOOK_SECRET=...

# Cron (vercel.json): any long random string. Vercel sends it to
# /api/cron/retry-orders, which recovers paid orders that weren't recorded and
# retries failed Shiprocket hand-offs and emails. Disabled while unset.
# CRON_SECRET=

# Shiprocket. Paid orders are sent to Shiprocket when all three are set.
# Use an API user (Settings -> API), not the account login.
# Magic Checkout's shipping URL is <site>/api/razorpay/shipping-info.
# SHIPROCKET_EMAIL=...
# SHIPROCKET_PASSWORD=...
# Pickup address nickname (Settings -> Pickup Addresses).
# SHIPROCKET_PICKUP_LOCATION=...

# Resend (order confirmation emails). Emails are sent only when both are set.
# The sender must be on a domain verified in Resend -> Domains. Until then,
# "onboarding@resend.dev" works but only delivers to the Resend account owner.
# RESEND_API_KEY=re_...
# EMAIL_FROM="Swithblade <orders@yourdomain.com>"
# Optional: where shopper replies go.
# EMAIL_REPLY_TO=
# Optional: staff inbox for alerts (orders paid but not shipped or emailed
# after an hour of retries, or recovered by the retry job).
# STORE_ALERT_EMAIL=support@yourdomain.com

# Upstash Redis (optional). Shares the Shiprocket token and PIN code checks
# across instances and turns on rate limits for sign-in, password reset and
# checkout. From the Upstash console -> your database -> REST API. The KV_REST_API_*
# names added by Vercel's Upstash integration work too.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
